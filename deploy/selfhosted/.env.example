# ── 部署配置模板: cp .env.example .env 后填密钥 ──────────────────
# 密钥生成: node utils/generate-keys.mjs (纯 node, 零依赖)

# Postgres(容器内 postgres 超管密码)
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres

# JWT(HS256) 密钥 — GoTrue 与 API key 共用
JWT_SECRET=change-me-at-least-32-chars
# Legacy API keys(用 JWT_SECRET 签发的 HS256 JWT)
ANON_KEY=change-me
SERVICE_ROLE_KEY=change-me

# Auth 对外地址(应用服务端访问网关的地址; 若跨机部署改成 http://<服务器内网IP>:18000)
API_EXTERNAL_URL=http://127.0.0.1:18000
SITE_URL=http://127.0.0.1:5000
GATEWAY_PORT=18000

# MinIO 对象存储
MINIO_ROOT_USER=exam-minio
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=exam-media
# 应用侧读取 MinIO 用的凭证(coze-coding-dev-sdk 走 AWS 默认凭证链)
AWS_ACCESS_KEY_ID=exam-minio
AWS_SECRET_ACCESS_KEY=change-me
AWS_REGION=cn-beijing
