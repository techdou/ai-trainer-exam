# Runtime
NODE_ENV=development
COZE_PROJECT_ENV=DEV

# Supabase
COZE_SUPABASE_URL=
COZE_SUPABASE_ANON_KEY=
COZE_SUPABASE_SERVICE_ROLE_KEY=
PGDATABASE_URL=

# S3 compatible storage
COZE_BUCKET_ENDPOINT_URL=
COZE_BUCKET_NAME=
COZE_BUCKET_ACCESS_KEY=
COZE_BUCKET_SECRET_KEY=
COZE_BUCKET_REGION=auto

# Coze SDK / workload
COZE_WORKLOAD_API_TOKEN=
COZE_PROJECT_SPACE_ID=
COZE_LOOP_BASE_URL=https://api.coze.cn

# Preferred image2-api provider (OpenAI Images compatible)
IMAGE2_API_BASE_URL=
IMAGE2_API_KEY=
IMAGE2_API_MODEL=gpt-image-1

# Preferred mimo-lecture-audio-skill provider
MIMO_LECTURE_AUDIO_URL=
MIMO_LECTURE_AUDIO_KEY=

# Seed (required in production; no default password is embedded)
SEED_ADMIN_PASSWORD=
